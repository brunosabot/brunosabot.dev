{
  "name": "brunosabot.dev",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "24.x"
  },
  "type": "module",
  "scripts": {
    "build": "next build",
    "dev": "next dev",
    "lint:css": "stylelint --fix components/**/*.css styles/**/*.css",
    "lint:format": "oxfmt \"**/*.{css,js,jsx,json,md,ts,tsx}\"",
    "lint:ts": "oxlint --fix components lib app",
    "lint": "oxlint",
    "postbuild": "next-sitemap",
    "start": "next start -p 8080",
    "preinstall": "npx only-allow pnpm"
  },
  "pnpm": {
    "overrides": {
      "csstype": "3.2.3"
    },
    "onlyBuiltDependencies": [
      "@vercel/speed-insights",
      "sharp"
    ]
  },
  "dependencies": {
    "@notionhq/client": "^5.31.1",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.1.0",
    "fuse.js": "^7.5.0",
    "lucide-react": "^1.79.0",
    "marked": "^18.3.0",
    "nanoid": "^6.0.2",
    "next": "16.4.6",
    "notion-to-md": "^3.1.10",
    "prismjs": "^1.30.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "reading-time": "^1.5.0",
    "sha.js": "^2.4.12",
    "sharp": "^0.35.5",
    "typescript": "7.0.2",
    "ulid": "^3.0.2",
    "uuid": "^14.0.3"
  },
  "devDependencies": {
    "@types/node": "24.19.4",
    "@types/prismjs": "^1.26.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/sha.js": "^2.4.4",
    "eslint-plugin-perfectionist": "^5.14.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.2",
    "next-sitemap": "^4.2.3",
    "oxfmt": "^0.80.0",
    "oxlint": "^1.95.0",
    "stylelint": "^17.16.0",
    "stylelint-config-css-modules": "^4.6.0",
    "stylelint-config-recommended": "^18.0.0",
    "stylelint-order": "^8.1.3"
  },
  "lint-staged": {
    "*.css": [
      "oxfmt",
      "stylelint --fix"
    ],
    "*.{js,jsx,ts,tsx}": [
      "oxlint --fix",
      "oxfmt"
    ],
    "*.{json,md}": [
      "oxfmt"
    ]
  }
}
